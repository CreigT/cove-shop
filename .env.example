# Store identity
NEXT_PUBLIC_STORE_NAME=Cove
NEXT_PUBLIC_STORE_TAGLINE=A calm digital shop. Agents keep the lights on.
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=you@email.com
NEXT_PUBLIC_OWNER_NAME=Your Name
NEXT_PUBLIC_DEMO_MODE=true
STORE_SECRET=change-me-to-a-long-random-string

# Stripe (live money needs these and NEXT_PUBLIC_DEMO_MODE=false)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_KIT=
STRIPE_PRICE_MEMBER=
STRIPE_PRICE_CARE=

# Storage: Vercel KV / Upstash Redis REST. Empty = in-memory demo storage that resets on restart.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email via Resend. Empty = emails are logged and skipped.
RESEND_API_KEY=
EMAIL_FROM=Cove <onboarding@resend.dev>
OWNER_EMAIL=

# AI, any OpenAI-compatible API. Empty = rule-based answers and fallback product ideas.
# OpenAI: https://api.openai.com/v1   Groq: https://api.groq.com/openai/v1   xAI: https://api.x.ai/v1
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_DAILY_CALL_CAP=200
AI_DAILY_TOKEN_CAP=200000

# Agent auth
CRON_SECRET=
ADMIN_TOKEN=

# Guardrails
KILL_SWITCH=false
REFUND_AUTO_CAP=29
REFUND_WINDOW_DAYS=14
PRICE_MIN=5
PRICE_MAX=49
PRICE_STEP_PCT=10
MAX_AGENT_PRODUCTS=12
AGENT_AUTOPUBLISH=true
DOWNLOAD_LINK_TTL_HOURS=72
TICKET_RATE_LIMIT=6

# Optional hooks
MARKETING_WEBHOOK_URL=
SALES_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT=
